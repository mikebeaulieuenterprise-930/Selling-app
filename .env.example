# Copie ce fichier en `.env.local` et remplis les valeurs. Ne commits jamais `.env.local`.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé "anon" (ou la nouvelle clé "publishable", les deux fonctionnent)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic → https://platform.claude.com → API keys
ANTHROPIC_API_KEY=

# URL publique de l'app (sert aux liens magiques). En local :
NEXT_PUBLIC_SITE_URL=http://localhost:3000
